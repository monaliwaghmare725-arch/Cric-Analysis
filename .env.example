# --- Server ---
# Default API port. On a machine that already runs another app on 3001 (e.g. LegalLens), use 3011.
PORT=3001
NODE_ENV=development

# Locked-down CORS: comma-separated allowed origins (no wildcards in production)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://triageiq:triageiq@localhost:5432/triageiq

# Triage engine: `demo` = explicit local rules (workshop / unpaid), `openai` = real OpenAI API
# openai mode fails clearly if the key is missing or credits are exhausted — no silent mock.
TRIAGE_MODE=demo

# OpenAI — required only when TRIAGE_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Client (Vite) ---
# Leave empty to use same-origin /api via the Vite proxy (recommended).
# Or set an absolute API URL, e.g. http://localhost:3001
VITE_API_BASE_URL=
