# --- Server ---
PORT=3001
NODE_ENV=development

# Locked-down CORS: comma-separated allowed origins (no wildcards in production)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://triageiq:triageiq@localhost:5432/triageiq

# OpenAI — required for triage. Server fails clearly if unset (no mock fallback).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Client (Vite) ---
VITE_API_BASE_URL=http://localhost:3001
